<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>BlogSpace | Discover Stories</title>

  <!-- Bootstrap 5 CSS -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  >

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <style>
    body {
      font-family: "Inter", sans-serif;
      background-color: #f8f9fc;
      color: #212529;
    }

    .navbar-brand {
      font-weight: 800;
      font-size: 1.5rem;
      letter-spacing: -1px;
    }

    .hero {
      background: linear-gradient(135deg, #eef2ff, #f8f9fc);
      padding: 100px 0;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      font-weight: 800;
      letter-spacing: -2px;
      line-height: 1.1;
    }

    .hero h1 span {
      color: #635bff;
    }

    .hero p {
      color: #6c757d;
      font-size: 1.1rem;
      line-height: 1.8;
    }

    .section-title {
      font-weight: 800;
      letter-spacing: -1px;
    }

    .post-card {
      border: none;
      border-radius: 16px;
      overflow: hidden;
      height: 100%;
      transition: transform 0.25s, box-shadow 0.25s;
    }

    .post-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
    }

    .post-card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
    }

    .category-badge {
      background-color: #eeecff;
      color: #635bff;
      font-weight: 600;
    }

    .post-title {
      font-weight: 700;
      line-height: 1.5;
    }

    .post-description {
      color: #6c757d;
      line-height: 1.7;
    }

    .newsletter {
      background: #212529;
      color: white;
      border-radius: 24px;
      padding: 55px 25px;
    }

    .newsletter p {
      color: #adb5bd;
    }

    .btn-primary {
      background-color: #635bff;
      border-color: #635bff;
    }

    .btn-primary:hover {
      background-color: #5046e5;
      border-color: #5046e5;
    }

    footer a {
      color: #6c757d;
      text-decoration: none;
    }

    footer a:hover {
      color: #635bff;
    }
  </style>
</head>

<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
    <div class="container py-2">

      <a class="navbar-brand" href="/">
        Blog<span class="text-primary">Space.</span>
      </a>

      <button
        class="navbar-toggler"
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#navbarMenu"
        aria-controls="navbarMenu"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="navbarMenu">

        <ul class="navbar-nav mx-auto gap-lg-3">
          <li class="nav-item">
            <a class="nav-link active" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#featured">Featured</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#latest">Latest Posts</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="#categories">Categories</a>
          </li>
        </ul>

        <div class="d-flex flex-wrap gap-2 mt-3 mt-lg-0">

          <% if (typeof isAuthenticated !== "undefined" && isAuthenticated) { %>

            <a href="/profile" class="btn btn-outline-primary px-3">
              My Profile
            </a>

            <a href="/auth/logout" class="btn btn-primary px-3">
              Logout
            </a>

          <% } else { %>

            <a href="/auth/login" class="btn btn-outline-primary px-3">
              Login
            </a>

            <a href="/auth/register" class="btn btn-primary px-3">
              Get Started
            </a>

          <% } %>

        </div>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container">
      <div class="row align-items-center g-5">

        <div class="col-lg-6">

          <span class="badge category-badge rounded-pill px-3 py-2 mb-4">
            YOUR DAILY DOSE OF INSPIRATION
          </span>

          <h1>
            Ideas worth<br>
            sharing. <span>Stories</span><br>
            worth reading.
          </h1>

          <p class="mt-4 mb-4">
            Discover fresh perspectives, learn something new, and explore
            stories about technology, lifestyle, creativity, and more.
          </p>

          <div class="d-flex flex-wrap gap-3">

            <a href="#latest" class="btn btn-primary btn-lg px-4">
              Explore Articles
            </a>

            <a href="#featured" class="btn btn-outline-dark btn-lg px-4">
              Featured Stories
            </a>

          </div>

          <div class="mt-5 text-secondary small">
            <strong class="text-dark">100+</strong> stories to explore
            <span class="mx-2">·</span>
            Ideas for curious minds
          </div>

        </div>

        <div class="col-lg-6">

          <img
            src="https://placehold.co/1200x700/EEF2FF/635BFF?text=BlogSpace"
            class="img-fluid rounded-4 shadow"
            alt="BlogSpace"
            style="width: 100%; height: 420px; object-fit: cover;"
          >

        </div>

      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-5" id="categories">
    <div class="container">

      <div class="d-flex justify-content-between align-items-center mb-4">

        <h2 class="section-title h3 mb-0">
          Explore Topics
        </h2>

        <a href="/categories" class="text-decoration-none fw-semibold">
          All categories &rarr;
        </a>

      </div>

      <div class="d-flex flex-wrap gap-2">

        <a
          href="/categories/technology"
          class="btn btn-light border rounded-pill px-4 py-2"
        >
          💻 Technology
        </a>

        <a
          href="/categories/programming"
          class="btn btn-light border rounded-pill px-4 py-2"
        >
          ⚡ Programming
        </a>

        <a
          href="/categories/design"
          class="btn btn-light border rounded-pill px-4 py-2"
        >
          🎨 Design
        </a>

        <a
          href="/categories/lifestyle"
          class="btn btn-light border rounded-pill px-4 py-2"
        >
          🌿 Lifestyle
        </a>

        <a
          href="/categories/business"
          class="btn btn-light border rounded-pill px-4 py-2"
        >
          🚀 Business
        </a>

      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="py-5" id="featured">
    <div class="container">

      <div class="mb-4">
        <span class="text-primary fw-semibold small">
          EDITOR'S PICKS
        </span>

        <h2 class="section-title mt-2">
          Featured Stories
        </h2>

        <p class="text-secondary">
          Handpicked articles to inspire your next big idea.
        </p>
      </div>

      <div class="row g-4">

        <!-- Featured Post 1 -->
        <div class="col-md-6">

          <article class="card post-card shadow-sm">

            <img
              src="https://placehold.co/1000x500/E0E7FF/3730A3?text=Technology"
              alt="Technology"
              loading="lazy"
            >

            <div class="card-body p-4">

              <span class="badge category-badge rounded-pill mb-3">
                Technology
              </span>

              <h3 class="post-title h4">
                The Future of Technology and Human Creativity
              </h3>

              <p class="post-description">
                Explore how modern technology is changing the way we work,
                think, create, and solve everyday problems.
              </p>

              <div class="d-flex justify-content-between align-items-center mt-4">

                <span class="small text-secondary">
                  By Alex Morgan
                </span>

                <a
                  href="/posts/future-of-technology"
                  class="text-primary fw-semibold text-decoration-none"
                >
                  Read article &rarr;
                </a>

              </div>
            </div>
          </article>
        </div>

        <!-- Featured Post 2 -->
        <div class="col-md-6">

          <article class="card post-card shadow-sm">

            <img
              src="https://placehold.co/1000x500/DCFCE7/166534?text=Productivity"
              alt="Productivity"
              loading="lazy"
            >

            <div class="card-body p-4">

              <span class="badge category-badge rounded-pill mb-3">
                Productivity
              </span>

              <h3 class="post-title h4">
                Building Better Habits for a More Productive Life
              </h3>

              <p class="post-description">
                Small, consistent changes can transform your daily routine
                and help you focus on what really matters.
              </p>

              <div class="d-flex justify-content-between align-items-center mt-4">

                <span class="small text-secondary">
                  By Sarah Wilson
                </span>

                <a
                  href="/posts/better-habits"
                  class="text-primary fw-semibold text-decoration-none"
                >
                  Read article &rarr;
                </a>

              </div>
            </div>
          </article>
        </div>

      </div>
    </div>
  </section>

  <!-- Latest Articles -->
  <section class="py-5" id="latest">
    <div class="container">

      <div class="d-flex justify-content-between align-items-end mb-4">

        <div>
          <span class="text-primary fw-semibold small">
            FRESHLY PUBLISHED
          </span>

          <h2 class="section-title mt-2 mb-0">
            Latest Articles
          </h2>
        </div>

        <a href="/posts" class="text-decoration-none fw-semibold">
          View all &rarr;
        </a>

      </div>

      <% const posts = [
        {
          title: "Getting Started with Modern Web Development",
          category: "Programming",
          description: "A beginner-friendly introduction to building modern websites and web applications.",
          author: "James Cooper",
          date: "Oct 10, 2026",
          image: "https://placehold.co/800x440/DBEAFE/1D4ED8?text=Programming",
          slug: "modern-web-development"
        },
        {
          title: "Finding Inspiration in Everyday Life",
          category: "Lifestyle",
          description: "Simple ways to notice the little things and bring more creativity into your life.",
          author: "Emma Davis",
          date: "Oct 9, 2026",
          image: "https://placehold.co/800x440/D1FAE5/065F46?text=Lifestyle",
          slug: "everyday-inspiration"
        },
        {
          title: "Design Principles Every Developer Should Know",
          category: "Design",
          description: "Learn the fundamentals of visual hierarchy, spacing, color, and accessible interfaces.",
          author: "Michael Lee",
          date: "Oct 8, 2026",
          image: "https://placehold.co/800x440/FCE7F3/9D174D?text=Design",
          slug: "design-principles"
        }
      ]; %>

      <div class="row g-4">

        <% posts.forEach(post => { %>

          <div class="col-md-6 col-lg-4">

            <article class="card post-card shadow-sm">

              <img
                src="<%= post.image %>"
                alt="<%= post.title %>"
                loading="lazy"
              >

              <div class="card-body p-4 d-flex flex-column">

                <div class="mb-3">
                  <span class="badge category-badge rounded-pill">
                    <%= post.category %>
                  </span>
                </div>

                <h3 class="post-title h5">
                  <%= post.title %>
                </h3>

                <p class="post-description">
                  <%= post.description %>
                </p>

                <div class="mt-auto pt-3 border-top">

                  <div class="d-flex justify-content-between align-items-center">

                    <div>
                      <div class="fw-semibold small">
                        <%= post.author %>
                      </div>

                      <div class="text-secondary small">
                        <%= post.date %>
                      </div>
                    </div>

                    <a
                      href="/posts/<%= post.slug %>"
                      class="btn btn-sm btn-outline-primary rounded-pill px-3"
                    >
                      Read More
                    </a>

                  </div>
                </div>
              </div>
            </article>
          </div>

        <% }); %>

      </div>
    </div>
  </section>

  <!-- Newsletter Section -->
  <section class="py-5">
    <div class="container">

      <div class="newsletter text-center">

        <span class="badge bg-secondary rounded-pill px-3 py-2 mb-3">
          STAY IN THE LOOP
        </span>

        <h2 class="section-title mb-3">
          Great stories, delivered to you.
        </h2>

        <p class="mb-4">
          Get our latest articles and ideas delivered straight to your inbox.
        </p>

        <form
          action="/newsletter/subscribe"
          method="POST"
          class="row g-2 justify-content-center mx-auto"
          style="max-width: 500px;"
        >

          <div class="col-sm-8">

            <label for="newsletterEmail" class="visually-hidden">
              Email address
            </label>

            <input
              type="email"
              name="email"
              id="newsletterEmail"
              class="form-control form-control-lg"
              placeholder="Enter your email address"
              required
            >

          </div>

          <div class="col-sm-4 d-grid">

            <button type="submit" class="btn btn-primary btn-lg">
              Subscribe
            </button>

          </div>

        </form>

        <p class="small mt-3 mb-0">
          No spam. Unsubscribe anytime.
        </p>

      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-white border-top mt-4">
    <div class="container py-4">

      <div class="row align-items-center gy-3">

        <div class="col-md-6">

          <a href="/" class="navbar-brand text-dark">
            Blog<span class="text-primary">Space.</span>
          </a>

          <p class="text-secondary small mt-2 mb-0">
            A home for ideas, stories, and curious minds.
          </p>

        </div>

        <div class="col-md-6">

          <div class="d-flex justify-content-md-end flex-wrap gap-3">
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/privacy">Privacy Policy</a>
          </div>

        </div>

      </div>

      <hr class="my-4">

      <p class="text-secondary small text-center mb-0">
        &copy; <%= new Date().getFullYear() %> BlogSpace. All rights reserved.
      </p>

    </div>
  </footer>

  <!-- Bootstrap 5 JS -->
  <script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
  ></script>

</body>
</html>
